# ===== Telegram =====
# Токен бота из @BotFather — замените на свой, не храните секрет в этом файле
BOT_TOKEN=PASTE_YOUR_ROTATED_BOT_TOKEN_HERE

# ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=YOUR_TELEGRAM_USER_ID

# ===== Google Таблицы =====
# Необязательно. Укажите ссылку на свою таблицу только в локальном .env.
GOOGLE_SHEET_URL=

# Путь к JSON-ключу сервисного аккаунта
GOOGLE_CREDENTIALS_PATH=credentials.json

# Альтернатива файлу: весь JSON ключа одной строкой (удобно для Docker/секретов).
# Если задан — имеет приоритет над GOOGLE_CREDENTIALS_PATH.
GOOGLE_CREDENTIALS_JSON=

# Необязательно: имя листа. Пусто — берётся лист по gid из ссылки или первый.
GOOGLE_WORKSHEET_NAME=

# ===== База данных =====
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# ===== Прочее =====
# Часовой пояс для дат в сообщениях и таблице
TIMEZONE=Europe/Moscow

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Сколько заявок показывать на странице в админке (1–20)
ORDERS_PER_PAGE=5

# Пауза между сообщениями рассылки, сек (защита от лимитов Telegram)
BROADCAST_DELAY=0.05 
